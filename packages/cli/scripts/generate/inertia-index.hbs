import { Link, router, useHenri } from '@usehenri/inertia';

// Rendered by the `index` action with `data: { {{plural}}: [...] }`. useHenri()
// reads the page Inertia carries: what the controller sent as `data`, and the
// path helpers of config/routes.js (`resources {{plural}}`), filtered by the
// current user's roles. The classes are Tailwind CSS, from
// app/views/styles/index.css: `dark:` follows the operating system.
const cell = 'px-4 py-3 text-sm';
const link = 'text-sm hover:underline';

export default function Index() {
  const { data, getRoute } = useHenri();
  const {{plural}} = data.{{plural}} || [];

  // An Inertia visit, not a fetch: the controller redirects to the listing
  // and the client renders the page it lands on.
  const destroy = (id) => {
    if (window.confirm('Delete this {{doc}}?')) {
      router.delete(getRoute('destroy_{{plural}}_path', id));
    }
  };

  return (
    <main className="mx-auto w-full max-w-4xl px-6 py-12">
      <div className="flex flex-wrap items-center justify-between gap-4">
        <h1 className="text-2xl font-semibold tracking-tight">{{doc}}</h1>
        <Link
          className="inline-flex items-center justify-center rounded-lg bg-zinc-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-zinc-700 dark:bg-zinc-50 dark:text-zinc-900 dark:hover:bg-zinc-200"
          href={getRoute('new_{{plural}}_path')}
        >
          New {{doc}}
        </Link>
      </div>

      <div className="mt-8 overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-800">
        <table className="w-full text-left">
          <thead className="border-b border-zinc-200 bg-zinc-50 text-xs uppercase text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
            <tr>
              {{#each keys}}
              <th className="px-4 py-2 font-medium">{{this}}</th>
              {{/each}}
              <th className="px-4 py-2 text-right font-medium">Actions</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-zinc-200 dark:divide-zinc-800">
            { {{plural}}.length === 0 && (
              <tr>
                <td
                  className="px-4 py-12 text-center text-sm text-zinc-500 dark:text-zinc-400"
                  colSpan={ {{keys.length}} + 1}
                >
                  Nothing to show
                </td>
              </tr>
            )}
            { {{plural}}.map((item) => (
              <tr
                key={item.externalId}
                className="hover:bg-zinc-50 dark:hover:bg-zinc-900"
              >
                {{#each keys}}
                <td className={cell}>{String(item.{{this}} ?? '')}</td>
                {{/each}}
                <td className={`${cell} space-x-4 whitespace-nowrap text-right`}>
                  <Link className={link} href={getRoute('show_{{plural}}_path', item.externalId)}>
                    Show
                  </Link>
                  <Link className={link} href={getRoute('edit_{{plural}}_path', item.externalId)}>
                    Edit
                  </Link>
                  <button
                    className="text-sm text-red-600 hover:underline dark:text-red-400"
                    type="button"
                    onClick={() => destroy(item.externalId)}
                  >
                    Destroy
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </main>
  );
}
