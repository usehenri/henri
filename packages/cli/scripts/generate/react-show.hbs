import Link from 'next/link';
import withHenri from '@usehenri/react';

// Rendered by the `show` action with `data: { {{lower}}: {...} }` (nothing when
// the record does not exist).
const Show = ({ data: { {{lower}} = null }, getRoute }) => {
  const item = Array.isArray({{lower}}) ? {{lower}}[0] : {{lower}};

  if (!item) {
    return (
      <div>
        <h2>{{doc}} not found</h2>
        <Link href={getRoute('index_{{plural}}_path')}>Back</Link>
      </div>
    );
  }

  const id = String(item._id ?? item.id);

  return (
    <div>
      <h2>{{doc}} {id}</h2>
      <hr />
      {{#each keys}}
      <div>
        <strong>{{this}}:</strong> {String(item.{{this}} ?? '')}
      </div>
      {{/each}}
      <p>
        <Link href={getRoute('edit_{{plural}}_path', id)}>Edit</Link>
        {' | '}
        <Link href={getRoute('index_{{plural}}_path')}>Back</Link>
      </p>
    </div>
  );
};

export default withHenri(Show);
