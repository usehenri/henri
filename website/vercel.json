{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install --filter @usehenri/website",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != master ]",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "*/*": false,
      "master": true
    }
  }
}
